# Served by Cloudflare static assets. Fingerprinted build output never changes, so cache it forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Strict-Transport-Security applies to www only: this file is served by the Worker, and the Worker
# only answers for www.bazautomation.com. The apex redirect and the Google Workspace subdomains
# (mail, drive, calendar) are untouched, which is why includeSubDomains is deliberately absent.
# Ramp max-age up once this has been live and uneventful: 1 day -> 30 days -> 1 year.
#
# The CSP is as tight as it is because the built site has no <script> tags at all, no <img>, no
# forms, no iframes and no external origins: fonts are self-hosted under /_astro/fonts/ and the
# only SVG is inline. 'unsafe-inline' is needed for style-src alone, because Astro emits a per-page
# inline <style>. Adding client JS, an image, a form or a data: URI means widening this line in the
# same commit, or the page silently loses the resource.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=86400
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
