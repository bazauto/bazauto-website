---
import { GITHUB_ORG, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
const REPO = `${GITHUB_ORG}/bazauto-website`;
---

<footer class="site-footer">
	<div class="inner">
		<span class="label"><span class="brand">{SITE_TITLE}</span> · {year}</span>
		<ul>
			<li><a href="/rss.xml">RSS</a></li>
			<li><a href={GITHUB_ORG}>GitHub</a></li>
		</ul>
		<p class="licence">
			Writing and photos <a href={`${REPO}/blob/main/LICENSE-CONTENT.txt`}>CC BY 4.0</a>{' · Code '}<a
				href={`${REPO}/blob/main/LICENSE`}>MIT</a
			>{' · Fonts '}<a href="/licenses/OFL.txt">SIL OFL 1.1</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--rule);
		background: var(--panel-sunken);
	}
	.inner {
		max-width: var(--wide);
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-block: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}
	.brand {
		text-transform: none;
		letter-spacing: 0.02em;
	}
	ul {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		font-family: var(--font-label);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.85rem;
		color: var(--ink-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	.licence {
		flex-basis: 100%;
		margin: 0;
		font-size: 0.8rem;
		color: var(--ink-muted);
	}
	.licence a {
		font-family: inherit;
		font-size: inherit;
		text-transform: none;
		letter-spacing: normal;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
