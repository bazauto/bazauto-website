---
import type { CollectionEntry } from 'astro:content';
import { decisionLamp } from '../lib/status';
import FormattedDate from './FormattedDate.astro';
import Lamp from './Lamp.astro';

interface Props {
	decisions: CollectionEntry<'decisions'>[];
}

const { decisions } = Astro.props;
---

{
	decisions.length === 0 ? (
		<p class="muted">No decisions recorded yet.</p>
	) : (
		<ul class="decisions">
			{decisions.map((d) => (
				<li>
					<Lamp colour={decisionLamp[d.data.status]} label={d.data.status} />
					<div>
						<a href={`/decisions/${d.id}/`}>{d.data.title}</a>
						<p class="muted">
							<FormattedDate date={d.data.date} /> · {d.data.summary}
						</p>
					</div>
				</li>
			))}
		</ul>
	)
}

<style>
	.decisions {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.9rem;
		align-items: start;
		padding-block: 0.8rem;
		border-bottom: 1px solid var(--rule);
	}
	li :global(.lamp-wrap) {
		padding-top: 0.45rem;
	}
	a {
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
</style>
